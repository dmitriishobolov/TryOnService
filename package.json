{
  "name": "try-on-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist-apps.mjs && tsc -p tsconfig.json",
    "build:dist": "npm run build && node scripts/build-dist.mjs",
    "build:devtest": "node scripts/devtest.mjs --build-only",
    "devtest": "node scripts/devtest.mjs",
    "dev:coordinator": "tsx apps/coordinator/index.ts",
    "dev:storage": "tsx apps/storage/index.ts",
    "dev:worker": "tsx apps/worker/index.ts",
    "dev:telegram": "tsx apps/client/telegram/index.ts",
    "start:coordinator": "node dist/apps/coordinator/index.js",
    "start:storage": "node dist/apps/storage/index.js",
    "start:worker": "node dist/apps/worker/index.js",
    "start:telegram": "node dist/apps/client/telegram/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:catalog-ingestor": "tsx apps/catalog-ingestor/index.ts",
    "start:catalog-ingestor": "node dist/apps/catalog-ingestor/index.js",
    "playwright:install": "playwright install chromium",
    "dev:catalog-parser": "tsx apps/catalog-ingestor/catalog/providers/custom/parser.ts",
    "dev:catalog-parser:tsum": "tsx apps/catalog-ingestor/catalog/providers/tsum/parser.ts",
    "monolith:ingest:tsum:male": "npm --prefix monolith run ingest:tsum:male",
    "monolith:ingest:tsum:female": "npm --prefix monolith run ingest:tsum:female",
    "monolith:ingest:tsum:all": "npm --prefix monolith run ingest:tsum:all",
    "monolith:ingest:tsum:fast": "npm --prefix monolith run ingest:tsum:fast",
    "monolith:ingest:tsum:male:fast": "npm --prefix monolith run ingest:tsum:male:fast",
    "monolith:ingest:tsum:female:fast": "npm --prefix monolith run ingest:tsum:female:fast",
    "monolith:ingest:tsum:all:fast": "npm --prefix monolith run ingest:tsum:all:fast",
    "monolith:ingest:tsum:male:enrich": "npm --prefix monolith run ingest:tsum:male:enrich",
    "monolith:ingest:tsum:female:enrich": "npm --prefix monolith run ingest:tsum:female:enrich",
    "monolith:ingest:tsum:all:enrich": "npm --prefix monolith run ingest:tsum:all:enrich",
    "monolith:ingest:lamoda:male": "npm --prefix monolith run ingest:lamoda:male",
    "monolith:ingest:lamoda:female": "npm --prefix monolith run ingest:lamoda:female",
    "monolith:ingest:lamoda:all": "npm --prefix monolith run ingest:lamoda:all",
    "monolith:lamoda:session": "npm --prefix monolith run lamoda:session",
    "monolith:ingest:lamoda:male:opera": "npm --prefix monolith run ingest:lamoda:male:opera",
    "monolith:ingest:lamoda:female:opera": "npm --prefix monolith run ingest:lamoda:female:opera",
    "monolith:ingest:lamoda:all:opera": "npm --prefix monolith run ingest:lamoda:all:opera",
    "monolith:lamoda:session:opera": "npm --prefix monolith run lamoda:session:opera"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "playwright": "^1.62.1"
  }
}
