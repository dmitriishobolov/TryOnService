# Пример окружения TryOnService
# Скопируйте файл в `.env` для локальной разработки и замените dev-секреты перед production.

# ---------------------------------------------------------------------------
# Сборка deploy-пакетов
# ---------------------------------------------------------------------------

# Env-файл, из которого `npm run build:dist` возьмет настройки для готовых пакетов.
# Если нужен другой файл, задайте эту переменную в shell перед запуском сборки.
BUILD_ENV_FILE=.env

# ---------------------------------------------------------------------------
# Devtest запуск всей инфраструктуры
# ---------------------------------------------------------------------------

# Env-файл, из которого `npm run devtest` соберет изолированный runtime `.env` в папке `devtest`.
DEVTEST_ENV_FILE=.env

# Сервисы для запуска одной командой: coordinator, storage, worker, telegram.
# Telegram client будет пропущен, если TELEGRAM_BOT_TOKEN оставлен demo-placeholder.
DEVTEST_SERVICES=coordinator,storage,worker,telegram

# Очищать папку devtest перед каждой сборкой и запуском.
DEVTEST_CLEAN=true

# Завершать devtest с ошибкой, если выбран telegram, но TELEGRAM_BOT_TOKEN не настроен.
DEVTEST_REQUIRE_TELEGRAM=false

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------

# Уровень логов для всех сервисов: debug, info, warn или error.
# По умолчанию info уже показывает lifecycle job: upload -> assignment -> worker -> callback.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Общие адреса сервисов
# ---------------------------------------------------------------------------

# URL coordinator, по которому к нему обращаются worker, storage-node и клиенты.
COORDINATOR_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# HTTP endpoint coordinator
# ---------------------------------------------------------------------------

# Порт, на котором coordinator принимает HTTP API.
COORDINATOR_PORT=3000

# Публичный URL coordinator для callback-адресов и job payload, которые получает worker.
COORDINATOR_PUBLIC_URL=http://localhost:3000

# Запрещать регистрацию worker, storage-node и clients с не-HTTPS публичными endpoint.
REQUIRE_HTTPS_ENDPOINTS=false

# ---------------------------------------------------------------------------
# Persistence coordinator
# ---------------------------------------------------------------------------

# Backend состояния coordinator: `memory` для dev или `postgres` для persistent state.
COORDINATOR_PERSISTENCE=memory

# Строка подключения к Postgres; используется только при COORDINATOR_PERSISTENCE=postgres.
POSTGRES_URL=postgres://tryon:tryon@localhost:5432/tryon

# Включить TLS для подключения coordinator к Postgres.
POSTGRES_SSL=false

# Максимальный размер Postgres pool в coordinator.
POSTGRES_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Admin и защита регистрации
# ---------------------------------------------------------------------------

# Admin/debug ключ для coordinator endpoints: /health, /jobs и /security/events.
ADMIN_API_KEY=dev-admin-key

# Общий ключ, по которому worker регистрируется в coordinator.
WORKER_REGISTRATION_KEY=dev-worker-registration-key

# Сколько неверных worker registration попыток с одного IP допускается до бана.
WORKER_REGISTRATION_MAX_INVALID_ATTEMPTS=5

# Общий ключ, по которому object storage node регистрируется в coordinator.
STORAGE_REGISTRATION_KEY=dev-storage-registration-key

# Сколько неверных storage registration попыток с одного IP допускается до бана.
STORAGE_REGISTRATION_MAX_INVALID_ATTEMPTS=5

# Общий ключ для регистрации service clients, heartbeat, storage access и создания jobs.
CLIENT_REGISTRATION_KEY=dev-client-registration-key

# Сколько неверных client registration попыток с одного IP допускается до бана.
CLIENT_REGISTRATION_MAX_INVALID_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Service-to-service ключи
# ---------------------------------------------------------------------------

# Общий service key для coordinator <-> worker вызовов после регистрации worker.
WORKER_SERVICE_KEY=dev-worker-service-key

# Общий service key для coordinator <-> storage-node вызовов после регистрации storage-node.
STORAGE_SERVICE_KEY=dev-storage-service-key

# ---------------------------------------------------------------------------
# Ключи и версии signed tokens
# ---------------------------------------------------------------------------

# Секрет подписи client -> worker dispatch token.
WORKER_DISPATCH_SIGNING_KEY=dev-worker-dispatch-signing-key

# Версия текущего worker dispatch signing key.
WORKER_DISPATCH_SIGNING_KEY_VERSION=dev-v1

# Секрет подписи worker -> client callback token.
CLIENT_CALLBACK_SIGNING_KEY=dev-client-callback-signing-key

# Версия текущего client callback signing key.
CLIENT_CALLBACK_SIGNING_KEY_VERSION=dev-v1

# Секрет подписи прямого client/worker -> storage-node access token.
STORAGE_ACCESS_SIGNING_KEY=dev-storage-access-signing-key

# Версия текущего storage access signing key.
STORAGE_ACCESS_SIGNING_KEY_VERSION=dev-v1

# ---------------------------------------------------------------------------
# Heartbeat, scheduler и TTL токенов
# ---------------------------------------------------------------------------

# Как часто worker отправляет coordinator данные о capacity и статусе.
WORKER_HEARTBEAT_INTERVAL_MS=5000

# Через сколько времени без heartbeat worker считается stale/offline.
WORKER_HEARTBEAT_TIMEOUT_MS=15000

# Как часто service client сообщает coordinator о готовности.
CLIENT_HEARTBEAT_INTERVAL_MS=5000

# Через сколько времени без heartbeat client считается stale/offline.
CLIENT_HEARTBEAT_TIMEOUT_MS=15000

# Как часто storage-node отправляет coordinator данные о capacity и статусе.
STORAGE_HEARTBEAT_INTERVAL_MS=5000

# Через сколько времени без heartbeat storage-node считается stale/offline.
STORAGE_HEARTBEAT_TIMEOUT_MS=15000

# Интервал housekeeping loop coordinator для expired assignments и stale resources.
SCHEDULER_INTERVAL_MS=1000

# Время жизни signed client -> worker dispatch token.
WORKER_DISPATCH_TOKEN_TTL_MS=30000

# Время жизни signed worker -> client callback token.
CLIENT_CALLBACK_TOKEN_TTL_MS=900000

# Время жизни signed client/worker -> storage-node access token.
STORAGE_ACCESS_TOKEN_TTL_MS=900000

# Сколько coordinator ждет, пока client отправит prepared assignment worker-у.
JOB_ASSIGNMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Общие HTTP лимиты
# ---------------------------------------------------------------------------

# Длительность fixed-window rate limit для входящих HTTP API запросов.
API_RATE_LIMIT_WINDOW_MS=60000

# Максимум запросов с одного direct IP за API_RATE_LIMIT_WINDOW_MS.
API_RATE_LIMIT_MAX_REQUESTS=120

# Timeout исходящих JSON HTTP вызовов между сервисами.
HTTP_CLIENT_TIMEOUT_MS=5000

# Количество retry для исходящих JSON HTTP вызовов между сервисами.
HTTP_CLIENT_RETRIES=1

# Максимальный размер JSON body для service API запросов.
MAX_JSON_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Object storage node
# ---------------------------------------------------------------------------

# Предпочтительный порт storage-node; если занят, сервис выберет ближайший свободный.
STORAGE_PORT=4200

# Стабильный storage-node id, который регистрируется в coordinator.
STORAGE_ID=local-storage-1

# Публичный протокол storage endpoint при автоопределении по IP registration-запроса и port.
STORAGE_PUBLIC_PROTOCOL=http

# Опциональный полный публичный storage endpoint для NAT, reverse proxy или домена.
STORAGE_PUBLIC_URL=

# Storage backend driver: `local` для dev или `s3` для S3-compatible backend.
STORAGE_DRIVER=local

# Локальная папка объектов для STORAGE_DRIVER=local.
STORAGE_LOCAL_ROOT=tmp/storage

# Файл metadata index для объектов и инкрементального usedBytes.
# Если пусто: local хранит index в STORAGE_LOCAL_ROOT, s3 - рядом в STORAGE_LOCAL_ROOT.
STORAGE_METADATA_PATH=

# Endpoint S3-compatible backend, например https://s3.amazonaws.com или http://localhost:9000.
# Используется только при STORAGE_DRIVER=s3.
STORAGE_S3_ENDPOINT=

# Region S3-compatible backend; для MinIO обычно можно оставить us-east-1.
STORAGE_S3_REGION=us-east-1

# Bucket S3-compatible backend.
STORAGE_S3_BUCKET=

# Access key id S3-compatible backend.
STORAGE_S3_ACCESS_KEY_ID=

# Secret access key S3-compatible backend.
STORAGE_S3_SECRET_ACCESS_KEY=

# Использовать path-style URL /bucket/key; включено для совместимости с MinIO.
STORAGE_S3_FORCE_PATH_STYLE=true

# Опциональная capacity storage-node для coordinator; пусто значит неизвестно/без лимита.
STORAGE_CAPACITY_BYTES=

# Максимальный размер одного upload, который принимает storage-node.
STORAGE_MAX_OBJECT_BYTES=26214400

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Предпочтительный порт worker; если занят, worker выберет ближайший свободный.
WORKER_PORT=4001

# Стабильный worker id, который регистрируется в coordinator.
WORKER_ID=local-worker-1

# Публичный протокол worker endpoint при автоопределении по IP registration-запроса и port.
WORKER_PUBLIC_PROTOCOL=http

# Опциональный полный публичный worker endpoint для NAT, reverse proxy или домена.
WORKER_PUBLIC_URL=

# Максимум jobs, которые worker может выполнять или держать prepared одновременно.
WORKER_CAPACITY=1

# Capabilities worker через запятую. Worker сам добавляет `try-on`, `try-on.mock`
# и `try-on.<provider>` для тех provider-ов, чьи API keys заполнены.
WORKER_CAPABILITIES=try-on,try-on.mock

# Индекс фото пользователя в payload.inputFiles; по умолчанию первый файл.
TRYON_PERSON_IMAGE_INDEX=0

# Индекс фото одежды/товара в payload.inputFiles; по умолчанию второй файл.
TRYON_GARMENT_IMAGE_INDEX=1

# Интервал polling-а async AI providers, которые возвращают job/generation id.
TRYON_MODEL_POLL_INTERVAL_MS=2000

# Максимум попыток polling-а async AI providers до timeout.
TRYON_MODEL_MAX_POLL_ATTEMPTS=60

# Timeout бинарных upload/download и вызовов внешних AI API.
TRYON_MODEL_HTTP_TIMEOUT_MS=120000

# Искусственная задержка mock TryOn model для локальных проверок.
MOCK_PROCESSING_DELAY_MS=700

# ---------------------------------------------------------------------------
# Worker AI provider: Pruna P-Image-Try-On
# ---------------------------------------------------------------------------

# API key Pruna; если заполнен, worker объявит capability `try-on.pruna`.
PRUNA_API_KEY=

# Base URL Pruna API.
PRUNA_API_BASE_URL=https://api.pruna.ai

# Имя модели Pruna для virtual try-on.
PRUNA_MODEL=p-image-try-on

# Шаблон polling endpoint, если Try-Sync не вернул готовый result URL.
PRUNA_PREDICTION_PATH_TEMPLATE=/v1/predictions/{predictionId}

# Формат результата Pruna.
PRUNA_OUTPUT_FORMAT=png

# Опциональное качество результата Pruna; пусто значит default provider-а.
PRUNA_OUTPUT_QUALITY=

# Сохранять размер входного изображения, если provider поддерживает опцию.
PRUNA_PRESERVE_INPUT_SIZE=true

# Опциональный prompt для Pruna.
PRUNA_PROMPT=

# Опциональный seed для воспроизводимости Pruna.
PRUNA_SEED=

# Включить turbo режим Pruna, если он доступен для аккаунта/модели.
PRUNA_TURBO=false

# ---------------------------------------------------------------------------
# Worker AI provider: Pixelcut Try-On API
# ---------------------------------------------------------------------------

# API key Pixelcut; если заполнен, worker объявит capability `try-on.pixelcut`.
PIXELCUT_API_KEY=

# Base URL Pixelcut Developer API.
PIXELCUT_API_BASE_URL=https://api.developer.pixelcut.ai

# Шаблон polling endpoint на случай async ответа с job_id.
PIXELCUT_JOB_STATUS_PATH_TEMPLATE=/v1/try-on/{jobId}

# Режим одежды Pixelcut; `auto` оставлен как совместимый default.
PIXELCUT_GARMENT_MODE=auto

# Предобработка garment image перед генерацией.
PIXELCUT_PREPROCESS_GARMENT=true

# Удалять фон в результате Pixelcut.
PIXELCUT_REMOVE_BACKGROUND=false

# ---------------------------------------------------------------------------
# Worker AI provider: TryOnCloud API
# ---------------------------------------------------------------------------

# API key TryOnCloud; если заполнен, worker объявит capability `try-on.tryoncloud`.
TRYONCLOUD_API_KEY=

# Base URL TryOnCloud API.
TRYONCLOUD_API_BASE_URL=https://www.tryoncloud.com

# Режим API: `developer` отправляет person/garment файлы и получает raw PNG;
# `platform` отправляет user_image + product_image_url и ожидает resultUrl.
TRYONCLOUD_MODE=developer

# ---------------------------------------------------------------------------
# Worker AI provider: Genlook Try-On API
# ---------------------------------------------------------------------------

# API key Genlook; если заполнен, worker объявит capability `try-on.genlook`.
GENLOOK_API_KEY=

# Base URL Genlook API; при отличии в dashboard переопределите здесь.
GENLOOK_API_BASE_URL=https://api.genlook.app

# Header, в котором worker передает Genlook API key.
GENLOOK_API_KEY_HEADER=Authorization

# Prefix значения auth header; поставьте `none`, если нужен чистый API key без Bearer.
GENLOOK_API_KEY_PREFIX=Bearer

# Как загрузить person image в Genlook: multipart или url.
GENLOOK_UPLOAD_MODE=multipart

# Endpoint загрузки person image в Genlook.
GENLOOK_UPLOAD_PATH=/tryon/v1/images/upload

# Endpoint создания try-on generation в Genlook.
GENLOOK_TRYON_PATH=/tryon/v1/try-on

# Шаблон polling endpoint Genlook generation.
GENLOOK_GENERATION_PATH_TEMPLATE=/tryon/v1/generations/{generationId}

# ---------------------------------------------------------------------------
# Worker AI provider: WEARFITS Virtual Try-On API
# ---------------------------------------------------------------------------

# API key WEARFITS; если заполнен, worker объявит capability `try-on.wearfits`.
WEARFITS_API_KEY=

# Base URL WEARFITS API.
WEARFITS_API_BASE_URL=https://api.wearfits.com

# Как передавать изображения в WEARFITS: base64 или url.
WEARFITS_IMAGE_INPUT_MODE=base64

# Категория товара для WEARFITS; `auto` оставляет классификацию provider-у.
WEARFITS_PRODUCT_CATEGORY=auto

# Качество генерации WEARFITS, если тариф/API поддерживает разные режимы.
WEARFITS_QUALITY=standard

# Просить WEARFITS сохранять фон person image, если provider поддерживает опцию.
WEARFITS_PRESERVE_BACKGROUND=true

# ---------------------------------------------------------------------------
# Worker AI provider: OpenAI / ChatGPT vision analysis
# ---------------------------------------------------------------------------

# OpenAI API key; если заполнен, worker объявит capability `try-on.openai`.
OPENAI_API_KEY=

# Base URL OpenAI API.
OPENAI_API_BASE_URL=https://api.openai.com

# Fallback-модель OpenAI Responses API, если client не передал payload.model.providerModel.
OPENAI_MODEL=gpt-5.6-luna

# Детализация изображения для OpenAI vision input: low, auto или high.
OPENAI_IMAGE_DETAIL=high

# Объемность текстового ответа OpenAI: low, medium или high.
OPENAI_TEXT_VERBOSITY=medium

# Усилие reasoning для OpenAI reasoning-моделей: none, minimal, low, medium, high или xhigh.
OPENAI_REASONING_EFFORT=low

# Режим reasoning; оставьте standard для стандартного режима Responses API.
OPENAI_REASONING_MODE=standard

# Максимум output tokens для текстового ответа OpenAI.
OPENAI_MAX_OUTPUT_TOKENS=900

# Хранить response state у OpenAI. Для пользовательских фото безопаснее false.
OPENAI_STORE_RESPONSE=false

# Опциональный OpenAI organization id.
OPENAI_ORGANIZATION=

# Опциональный OpenAI project id.
OPENAI_PROJECT=

# System prompt для безопасного анализа внешности без идентификации личности.
OPENAI_SYSTEM_PROMPT=Ты аккуратный fashion assistant. Анализируй только видимые признаки стиля, одежды, цветов, пропорций и контекста гардероба. Не пытайся устанавливать личность человека и не делай выводы о чувствительных признаках.

# Prompt по умолчанию, если клиент не передал payload.text.
OPENAI_WARDROBE_PROMPT=Кратко проанализируй внешность человека на фотографии. Сначала дай 2-3 живые фразы общего вывода: что считывается во внешности, что стоит подчеркнуть и какая подача будет смотреться естественно. Затем дай блок параметров: форма лица, визуальный контраст, видимые пропорции, подходящие цвета, чего избегать, фасоны одежды, аксессуары, прическа и 3 стилевых направления. Не более 1300 символов. Не используй длинное тире, символ U+2014 и похожие длинные тире; вместо них ставь запятую, двоеточие, точку с запятой или обычный дефис. Не пытайся устанавливать личность человека. Если освещение мешает точно определить цветотип, явно скажи об этом.

# ---------------------------------------------------------------------------
# Telegram client
# ---------------------------------------------------------------------------

# Стабильный client id Telegram-интеграции для регистрации в coordinator.
TELEGRAM_CLIENT_ID=telegram-client-1

# Предпочтительный порт callback server; если занят, client выберет ближайший свободный.
TELEGRAM_CLIENT_PORT=4100

# Публичный протокол Telegram callback endpoint при автоопределении.
TELEGRAM_CLIENT_PUBLIC_PROTOCOL=http

# Опциональный полный публичный Telegram callback endpoint для NAT, reverse proxy или домена.
TELEGRAM_CLIENT_PUBLIC_URL=

# Telegram Bot API token для процесса бота.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# Timeout long polling запросов к Telegram Bot API.
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
