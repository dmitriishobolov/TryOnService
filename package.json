{
  "name": "try-on-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist-apps.mjs && tsc -p tsconfig.json",
    "build:dist": "npm run build && node scripts/build-dist.mjs",
    "build:devtest": "node scripts/devtest.mjs --build-only",
    "devtest": "node scripts/devtest.mjs",
    "dev:coordinator": "tsx apps/coordinator/index.ts",
    "dev:storage": "tsx apps/storage/index.ts",
    "dev:worker": "tsx apps/worker/index.ts",
    "dev:telegram": "tsx apps/client/telegram/index.ts",
    "start:coordinator": "node dist/apps/coordinator/index.js",
    "start:storage": "node dist/apps/storage/index.js",
    "start:worker": "node dist/apps/worker/index.js",
    "start:telegram": "node dist/apps/client/telegram/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:catalog-ingestor": "tsx apps/catalog-ingestor/index.ts",
    "start:catalog-ingestor": "node dist/apps/catalog-ingestor/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
