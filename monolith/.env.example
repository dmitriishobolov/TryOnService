# TryOnService Monolith MVP
# Скопируйте файл в monolith/.env и заполните секреты.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Уровень логов: debug, info, warn или error.
LOG_LEVEL=info

# Локальная папка runtime-данных: входные фото, каталог, картинки товаров, результаты TryOn.
MONOLITH_STORAGE_ROOT=.monolith-data

# Максимальный размер скачиваемого изображения из Telegram, каталога или TryOn API.
MONOLITH_MAX_DOWNLOAD_BYTES=26214400

# Общий timeout прямых вызовов Telegram/OpenAI/TryOn/каталога.
MONOLITH_HTTP_TIMEOUT_MS=120000

# Искусственная задержка mock TryOn provider-а для проверки сценария без внешнего API.
MOCK_PROCESSING_DELAY_MS=700

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Токен Telegram-бота от BotFather.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>

# Timeout long polling Telegram API.
TELEGRAM_POLLING_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# OpenAI / ChatGPT
# ---------------------------------------------------------------------------

# API key OpenAI. Нужен для анализа внешности и подбора образа.
OPENAI_API_KEY=<openai-api-key>

# Base URL OpenAI API. Обычно менять не нужно.
OPENAI_API_BASE_URL=https://api.openai.com

# Модель OpenAI по умолчанию, если MONOLITH_OPENAI_MODEL пустой.
OPENAI_MODEL=gpt-5.6-luna

# Модель OpenAI именно для monolith.
MONOLITH_OPENAI_MODEL=gpt-5.6-luna

# Детализация входных изображений: low, auto или high.
OPENAI_IMAGE_DETAIL=high

# Краткость/подробность ответа модели: low, medium или high.
OPENAI_TEXT_VERBOSITY=low

# Усилие reasoning: none, minimal, low, medium, high, xhigh или max.
OPENAI_REASONING_EFFORT=low

# Режим reasoning для Responses API.
OPENAI_REASONING_MODE=standard

# Максимум output tokens для короткого ответа анализа внешности.
MONOLITH_OPENAI_MAX_OUTPUT_TOKENS=650

# Сохранять response на стороне OpenAI, если provider поддерживает этот флаг.
OPENAI_STORE_RESPONSE=false

# Опциональная OpenAI organization.
OPENAI_ORGANIZATION=

# Опциональный OpenAI project id.
OPENAI_PROJECT=

# Системный prompt для анализа. Можно оставить пустым, тогда будет использован prompt из кода.
OPENAI_SYSTEM_PROMPT=

# ---------------------------------------------------------------------------
# TryOn provider
# ---------------------------------------------------------------------------

# TryOn provider внутри monolith: mock для проверки без внешнего TryOn API или pruna для реальной примерки.
MONOLITH_TRYON_PROVIDER=mock

# API key Pruna. Нужен только если MONOLITH_TRYON_PROVIDER=pruna.
PRUNA_API_KEY=

# Base URL Pruna API.
PRUNA_API_BASE_URL=https://api.pruna.ai

# Модель Pruna для virtual try-on.
PRUNA_MODEL=p-image-try-on

# Шаблон пути polling prediction. {predictionId} заменяется на id задачи.
PRUNA_PREDICTION_PATH_TEMPLATE=/v1/predictions/{predictionId}

# Формат результата Pruna.
PRUNA_OUTPUT_FORMAT=png

# Качество результата Pruna, если API поддерживает этот параметр.
PRUNA_OUTPUT_QUALITY=

# Сохранять исходный размер изображения пользователя, если API поддерживает параметр.
PRUNA_PRESERVE_INPUT_SIZE=true

# Дополнительный prompt для Pruna.
PRUNA_PROMPT=

# Seed для воспроизводимости, если API поддерживает параметр.
PRUNA_SEED=

# Turbo режим Pruna, если API поддерживает параметр.
PRUNA_TURBO=false

# ---------------------------------------------------------------------------
# Local catalog
# ---------------------------------------------------------------------------

# Включить локальный каталог одежды для сценария `Идеальный образ`.
MONOLITH_CATALOG_ENABLED=true

# Обновлять каталог автоматически при старте бота. Для большого TSUM-каталога лучше запускать ingest отдельно.
MONOLITH_CATALOG_REFRESH_ON_START=false

# Provider-ы локального каталога. Сейчас реализованы `tsum` и `lamoda`.
MONOLITH_CATALOG_PROVIDERS=tsum,lamoda

# Мужские каталоги TSUM через запятую. Текущий URL даёт 591 страницу мужской одежды.
MONOLITH_CATALOG_TSUM_MALE_URLS=https://www.tsum.ru/catalog/odezhda-2409/

# Женские каталоги TSUM через запятую. Текущий URL ведёт на женскую одежду TSUM.
MONOLITH_CATALOG_TSUM_FEMALE_URLS=https://www.tsum.ru/catalog/odezhda-18413/

# Legacy/generic TSUM URL-ы через запятую. Используйте, если источник не мужской и не женский явно.
MONOLITH_CATALOG_TSUM_URLS=

# Пол/сегмент для legacy/generic URL-ов: male, female или unisex.
MONOLITH_CATALOG_TSUM_DEFAULT_GENDER=unisex

# Максимум страниц на один TSUM URL. 0 означает собрать все страницы, найденные в pageCount.
MONOLITH_CATALOG_TSUM_MAX_PAGES=0

# Пауза между страницами TSUM, чтобы не долбить сайт слишком резко.
MONOLITH_CATALOG_TSUM_PAGE_DELAY_MS=250

# Сколько раз повторять чтение страницы TSUM, если страница временно не отдала товары.
MONOLITH_CATALOG_TSUM_PAGE_RETRY_ATTEMPTS=3

# Базовая задержка между retry TSUM. Следующие retry ждут кратно дольше.
MONOLITH_CATALOG_TSUM_RETRY_DELAY_MS=5000

# Как часто писать прогресс чтения страниц TSUM в лог.
MONOLITH_CATALOG_TSUM_PROGRESS_EVERY_PAGES=25

# Обогащать товар данными со страницы товара TSUM: off - не ходить на карточки, missing - только если в листинге нет размеров/цвета, all - зайти в каждую карточку и забрать доступные размеры и все цвета семейства.
MONOLITH_CATALOG_TSUM_PRODUCT_ENRICHMENT=off

# Сколько страниц конкретных товаров TSUM открывать параллельно при обычном refresh. 1 безопаснее для ручных запусков.
MONOLITH_CATALOG_TSUM_PRODUCT_CONCURRENCY=1

# Пауза между переходами на страницы конкретных товаров TSUM при product enrichment.
MONOLITH_CATALOG_TSUM_PRODUCT_PAGE_DELAY_MS=1000

# Timeout чтения страницы конкретного товара TSUM. Отдельный от общего browser timeout, чтобы зависшие карточки не тормозили страницу каталога.
MONOLITH_CATALOG_TSUM_PRODUCT_PAGE_TIMEOUT_MS=15000

# Сколько раз повторять чтение страницы конкретного товара TSUM.
MONOLITH_CATALOG_TSUM_PRODUCT_PAGE_RETRY_ATTEMPTS=2

# Базовая задержка retry для страницы конкретного товара TSUM.
MONOLITH_CATALOG_TSUM_PRODUCT_RETRY_DELAY_MS=3000

# Максимум товаров за один проход parser-а. 0 означает без лимита.
MONOLITH_CATALOG_BATCH_SIZE=0

# Скачивать изображения товаров в MONOLITH_STORAGE_ROOT/catalog-image сразу при refresh.
MONOLITH_CATALOG_DOWNLOAD_IMAGES_ON_REFRESH=true

# Сколько изображений товаров скачивать параллельно при refresh.
MONOLITH_CATALOG_IMAGE_DOWNLOAD_CONCURRENCY=3

# Пауза между скачиваниями изображений товаров при refresh. 0 означает без паузы.
MONOLITH_CATALOG_IMAGE_DOWNLOAD_DELAY_MS=0

# Сколько кандидатов из локального каталога искать на каждую категорию одежды.
MONOLITH_CATALOG_CANDIDATES_PER_CATEGORY=5

# JSON-файл локального каталога. Если оставить default, он будет внутри MONOLITH_STORAGE_ROOT.
MONOLITH_CATALOG_CACHE_PATH=.monolith-data/catalog/items.json

# Запускать Playwright Chromium в headless-режиме для чтения каталогов.
MONOLITH_CATALOG_BROWSER_HEADLESS=true

# Timeout открытия страниц каталога через Playwright.
MONOLITH_CATALOG_BROWSER_TIMEOUT_MS=30000

# Состояние загрузки страницы для Playwright: load, domcontentloaded или networkidle.
MONOLITH_CATALOG_BROWSER_WAIT_UNTIL=domcontentloaded

# User-Agent для чтения каталога и скачивания изображений товаров.
MONOLITH_CATALOG_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ---------------------------------------------------------------------------
# Slow TSUM full ingest
# ---------------------------------------------------------------------------

# Режим slow-сбора TSUM: male, female или all. Команды package.json передают режим через --mode.
MONOLITH_TSUM_SLOW_MODE=all

# Профиль скорости: safe бережный, fast рассчитан примерно на сбор крупного каталога за час плюс-минус.
# Команды ingest:tsum:*:fast передают --profile=fast, но значения ниже тоже выставлены под быстрый проход.
MONOLITH_TSUM_SLOW_PROFILE=fast

# URL-ы мужского каталога TSUM для медленного полного сбора. Если пусто, берутся MONOLITH_CATALOG_TSUM_MALE_URLS.
MONOLITH_TSUM_SLOW_MALE_URLS=

# URL-ы женского каталога TSUM для медленного полного сбора. Если пусто, берутся MONOLITH_CATALOG_TSUM_FEMALE_URLS.
MONOLITH_TSUM_SLOW_FEMALE_URLS=

# Сколько страниц собрать в slow-команде. 0 означает все найденные страницы.
MONOLITH_TSUM_SLOW_MAX_PAGES=0

# Максимум товаров в slow-команде. 0 означает без лимита.
MONOLITH_TSUM_SLOW_BATCH_SIZE=0

# Пауза между страницами. 2000 мс мягче для сайта, а скорость в основном даёт параллельное скачивание картинок.
MONOLITH_TSUM_SLOW_PAGE_DELAY_MS=2000

# Количество повторных попыток чтения страницы.
MONOLITH_TSUM_SLOW_PAGE_RETRY_ATTEMPTS=5

# Базовая задержка между retry. Следующие retry ждут кратно дольше.
MONOLITH_TSUM_SLOW_RETRY_DELAY_MS=5000

# Как часто писать прогресс в лог. 2 удобно для быстрого мониторинга fast-сбора.
MONOLITH_TSUM_SLOW_PROGRESS_EVERY_PAGES=2

# Product enrichment для slow-сбора: off быстрее всего, missing добирает карточку при пустых размерах/цветах, all собирает полный набор цветов и размеров с каждой страницы товара.
MONOLITH_TSUM_SLOW_PRODUCT_ENRICHMENT=off

# Сколько страниц конкретных товаров TSUM открывать параллельно в slow/enrich-сборе. 1 - старый медленный последовательный режим без всплеска запросов.
MONOLITH_TSUM_SLOW_PRODUCT_CONCURRENCY=1

# Пауза между страницами конкретных товаров в slow-сборе. 1000 мс спокойнее для enrich-обхода.
MONOLITH_TSUM_SLOW_PRODUCT_PAGE_DELAY_MS=1000

# Timeout чтения страницы конкретного товара в slow/enrich-сборе.
MONOLITH_TSUM_SLOW_PRODUCT_PAGE_TIMEOUT_MS=12000

# Retry чтения страницы конкретного товара в slow-сборе.
MONOLITH_TSUM_SLOW_PRODUCT_PAGE_RETRY_ATTEMPTS=2

# Базовая задержка retry для страницы конкретного товара в slow-сборе.
MONOLITH_TSUM_SLOW_PRODUCT_RETRY_DELAY_MS=3000

# Сколько изображений товаров скачивать параллельно. 24 - быстрый режим; safe-режим обычно 1-4.
MONOLITH_TSUM_SLOW_IMAGE_DOWNLOAD_CONCURRENCY=24

# Пауза между скачиваниями изображений. Для fast-сбора 0, для бережного режима можно поставить 100-250.
MONOLITH_TSUM_SLOW_IMAGE_DOWNLOAD_DELAY_MS=0

# Путь к checkpoint-файлу slow-команды. Если пусто, будет .monolith-data/catalog/tsum-all-ingest-checkpoint.json, tsum-male-ingest-checkpoint.json или tsum-female-ingest-checkpoint.json по режиму.
MONOLITH_TSUM_SLOW_CHECKPOINT_PATH=

# true сбрасывает checkpoint и начинает обход с первой страницы. Уже скачанные товары/картинки остаются в локальной базе.
MONOLITH_TSUM_SLOW_RESET=false

# ---------------------------------------------------------------------------
# Lamoda catalog
# ---------------------------------------------------------------------------

# Мужские каталоги Lamoda через запятую. Используются обычным refresh, если включить provider lamoda.
MONOLITH_CATALOG_LAMODA_MALE_URLS=https://www.lamoda.ru/c/477/clothes-muzhskaya-odezhda

# Женские каталоги Lamoda через запятую. Используются обычным refresh, если включить provider lamoda.
MONOLITH_CATALOG_LAMODA_FEMALE_URLS=https://www.lamoda.ru/c/355/clothes-zhenskaya-odezhda

# Generic Lamoda URL-ы через запятую, если источник не мужской и не женский явно.
MONOLITH_CATALOG_LAMODA_URLS=

# Пол/сегмент для generic Lamoda URL-ов: male, female или unisex.
MONOLITH_CATALOG_LAMODA_DEFAULT_GENDER=unisex

# Максимум страниц на один Lamoda URL при обычном refresh. 0 означает все найденные страницы.
MONOLITH_CATALOG_LAMODA_MAX_PAGES=0

# Пауза между страницами Lamoda при обычном refresh.
MONOLITH_CATALOG_LAMODA_PAGE_DELAY_MS=2000

# Сколько раз повторять чтение страницы Lamoda, если карточки временно не появились.
MONOLITH_CATALOG_LAMODA_PAGE_RETRY_ATTEMPTS=3

# Базовая задержка между retry Lamoda. Следующие retry ждут кратно дольше.
MONOLITH_CATALOG_LAMODA_RETRY_DELAY_MS=5000

# Как часто писать прогресс чтения страниц Lamoda в лог.
MONOLITH_CATALOG_LAMODA_PROGRESS_EVERY_PAGES=5

# Сколько ждать на 403-странице Lamoda перед reload. Для ручной проверки ставьте headless=false и, например, 60000.
MONOLITH_CATALOG_LAMODA_SECURITY_WAIT_MS=0

# Persistent browser profile for Lamoda Playwright sessions.
# Cookies and manual checks are stored here between parser runs.
MONOLITH_CATALOG_LAMODA_USER_DATA_DIR=.monolith-data/browser/lamoda

# Browser channel for Lamoda parser: chromium, chrome, msedge or opera.
# chrome/msedge use Playwright channels; opera uses an installed Opera executable path.
MONOLITH_CATALOG_LAMODA_BROWSER_CHANNEL=chromium

# Optional path to Opera executable when MONOLITH_CATALOG_LAMODA_BROWSER_CHANNEL=opera.
# Leave empty to auto-detect common Opera and Opera GX install paths.
MONOLITH_CATALOG_LAMODA_BROWSER_EXECUTABLE_PATH=

# Product-page enrichment for ordinary Lamoda refresh: off, missing or all.
# `missing` opens /p/... only when the catalog page does not provide enough product data.
MONOLITH_CATALOG_LAMODA_PRODUCT_ENRICHMENT=off

# How many Lamoda product pages can be opened in parallel during ordinary refresh.
MONOLITH_CATALOG_LAMODA_PRODUCT_CONCURRENCY=1

# Pause after each Lamoda product page read during ordinary refresh.
MONOLITH_CATALOG_LAMODA_PRODUCT_PAGE_DELAY_MS=1000

# Timeout for one Lamoda product page during ordinary refresh.
MONOLITH_CATALOG_LAMODA_PRODUCT_PAGE_TIMEOUT_MS=20000

# Retry attempts for one Lamoda product page during ordinary refresh.
MONOLITH_CATALOG_LAMODA_PRODUCT_PAGE_RETRY_ATTEMPTS=2

# Base delay between Lamoda product-page retries during ordinary refresh.
MONOLITH_CATALOG_LAMODA_PRODUCT_RETRY_DELAY_MS=3000

# ---------------------------------------------------------------------------
# Lamoda resumable ingest
# ---------------------------------------------------------------------------

# Режим сбора Lamoda: male, female или all. Команды package.json передают режим через --mode.
MONOLITH_LAMODA_MODE=all

# URL-ы мужского каталога Lamoda для отдельной ingest-команды. Если пусто, берутся MONOLITH_CATALOG_LAMODA_MALE_URLS.
MONOLITH_LAMODA_MALE_URLS=

# URL-ы женского каталога Lamoda для отдельной ingest-команды. Если пусто, берутся MONOLITH_CATALOG_LAMODA_FEMALE_URLS.
MONOLITH_LAMODA_FEMALE_URLS=

# Сколько страниц собрать в отдельной Lamoda-команде. 0 означает все найденные страницы.
MONOLITH_LAMODA_MAX_PAGES=0

# Максимум товаров в отдельной Lamoda-команде. 0 означает без лимита.
MONOLITH_LAMODA_BATCH_SIZE=0

# Пауза между страницами в отдельной Lamoda-команде.
MONOLITH_LAMODA_PAGE_DELAY_MS=2000

# Количество повторных попыток чтения страницы Lamoda.
MONOLITH_LAMODA_PAGE_RETRY_ATTEMPTS=3

# Базовая задержка между retry Lamoda.
MONOLITH_LAMODA_RETRY_DELAY_MS=5000

# Как часто писать прогресс отдельной Lamoda-команды.
MONOLITH_LAMODA_PROGRESS_EVERY_PAGES=5

# Override ожидания ручной проверки Lamoda для отдельной ingest-команды.
MONOLITH_LAMODA_SECURITY_WAIT_MS=0

# Override browser mode for standalone Lamoda ingest.
# false opens a visible browser, useful when Lamoda asks for a manual check.
MONOLITH_LAMODA_BROWSER_HEADLESS=false

# Browser channel override for standalone Lamoda commands: chromium, chrome, msedge or opera.
# Use chrome, msedge or opera when that browser is installed locally.
MONOLITH_LAMODA_BROWSER_CHANNEL=chrome

# Optional path to Opera executable for standalone Lamoda commands.
# Leave empty to auto-detect common Opera and Opera GX install paths.
MONOLITH_LAMODA_BROWSER_EXECUTABLE_PATH=

# Override persistent browser profile for standalone Lamoda ingest.
# Leave empty to reuse MONOLITH_CATALOG_LAMODA_USER_DATA_DIR.
MONOLITH_LAMODA_USER_DATA_DIR=

# Start URL for manual Lamoda session setup.
MONOLITH_LAMODA_SESSION_URL=https://www.lamoda.ru/

# Catalog URL used to verify that the saved Lamoda session is usable.
MONOLITH_LAMODA_SESSION_VERIFY_URL=https://www.lamoda.ru/c/477/clothes-muzhskaya-odezhda

# Optional extra time to keep the manual Lamoda browser open after verification.
MONOLITH_LAMODA_SESSION_KEEP_OPEN_MS=0
# Product-page enrichment for standalone Lamoda ingest: off, missing or all.
# `missing` is the default for ingest and opens /p/... only when product data is incomplete.
MONOLITH_LAMODA_PRODUCT_ENRICHMENT=missing

# How many Lamoda product pages can be opened in parallel by standalone ingest.
MONOLITH_LAMODA_PRODUCT_CONCURRENCY=1

# Pause after each Lamoda product page read by standalone ingest.
MONOLITH_LAMODA_PRODUCT_PAGE_DELAY_MS=1000

# Timeout for one Lamoda product page in standalone ingest.
MONOLITH_LAMODA_PRODUCT_PAGE_TIMEOUT_MS=20000

# Retry attempts for one Lamoda product page in standalone ingest.
MONOLITH_LAMODA_PRODUCT_PAGE_RETRY_ATTEMPTS=2

# Base delay between Lamoda product-page retries in standalone ingest.
MONOLITH_LAMODA_PRODUCT_RETRY_DELAY_MS=3000

# Сколько изображений Lamoda скачивать параллельно после чтения страницы.
MONOLITH_LAMODA_IMAGE_DOWNLOAD_CONCURRENCY=8

# Пауза между скачиваниями изображений Lamoda. 0 означает без паузы.
MONOLITH_LAMODA_IMAGE_DOWNLOAD_DELAY_MS=0

# Путь к checkpoint-файлу Lamoda. Если пусто, будет .monolith-data/catalog/lamoda-*-ingest-checkpoint.json.
MONOLITH_LAMODA_CHECKPOINT_PATH=

# true сбрасывает checkpoint Lamoda и начинает обход с первой страницы. Уже скачанные товары/картинки остаются в локальной базе.
MONOLITH_LAMODA_RESET=false

